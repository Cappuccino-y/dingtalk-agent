# dingtalk-agent 配置模板 —— 复制成 .env 再填真值
# .env 不进 git；新增键请同步这里（只写键名与说明，不写真实值）

# ---- 钉钉应用（企业内机器人 / Stream 模式）----
APP_KEY=
APP_SECRET=
# 群机器人 webhook（主动推送文本/图片用；oToMessages 单人推送走 APP_KEY）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 最近活跃用户会由机器人自动写入 tools/.dingtalk_recipient.json

# ---- 主模型（火山方舟 Agent Plan，OpenCode 侧实际用的是 provider 配置）----
MINIMAX_API_KEY=

# ---- 自我改进扫描专用通道（与主模型解耦，OpenAI 兼容）----
# 提案者直连这个端点，不经过 OpenCode，因此没有任何工具
EVOLVE_LLM_BASE_URL=https://api.minimaxi.com/v1
EVOLVE_LLM_MODEL=MiniMax-M3.1-Flash
# 主模型欠费/限流/超时时自动降级到它
EVOLVE_LLM_FALLBACK_MODEL=MiniMax-M3

# ---- 小模型（report_news_data / 早报摘要用，OpenAI 兼容）----
LLM_API_KEY=
LLM_MODEL_ID=
LLM_MODEL_BOT_FINANCE_ID=
LLM_BASE_URL=
LLM_BASE_BOT_FINANCE_URL=
AGENT_ID=

# ---- 金十快讯（market_news 的会话凭据，过期需重抓）----
JIN10_COOKIE=

# ---- 卡片渲染开关 ----
# 0=回退 SDK 自带 AI 卡片（v1）；1=公共模板 + 卡片 OpenAPI（v2）
DINGTALK_CARD_V2=1
# 0=提问退回文字；1=结构化提问卡（选项式，最多 6 个）
DINGTALK_ASK_CARD=1

# ---- 卡片实时性调参 ----
DINGTALK_CARD_STATUS_REFRESH=1.0
DINGTALK_CARD_MIN_INTERVAL=0.5
DINGTALK_CARD_SETTLE=1.0
DINGTALK_CARD_SETTLE_PER_CHAR=0.01
DINGTALK_CARD_SETTLE_MAX=2.5

# ---- 匀速出字节拍（smooth streaming）----
# 全程同一速率，收尾不加速；单帧不超过一行，切点吸附到行/句边界
DINGTALK_CARD_PACE_TICK=0.25
DINGTALK_CARD_PACE_RATE=22
DINGTALK_CARD_PACE_MAX_CHARS=8
DINGTALK_CARD_PACE_SNAP=8
DINGTALK_CARD_PACE_DRAIN_RATE=22
DINGTALK_CARD_PACE_DRAIN_MAX=120
DINGTALK_CARD_PACE_DRAIN_BUDGET=10

# ---- 流式正文 / 折叠规避 ----
# 0 = 生成中推全量正文（想看全篇必须设 0）
# >0 = 只推最近 N 字（躲折叠用，会看不到前面内容）
DINGTALK_CARD_TAIL_WINDOW=0
# 活动面板保留几行最近步骤
DINGTALK_CARD_TRAIL=3
# 刚推过正文的 N 秒内不碰 instances（整卡重绘）
DINGTALK_CARD_INSTANCES_QUIET=2.5
# 群聊头部引用（只影响群聊）
DINGTALK_CARD_QUOTE=0
